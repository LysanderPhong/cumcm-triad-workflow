{
  "schema_version": "1.0",
  "style_name": "reference-cumcm-scientific",
  "status": "REFERENCE_BASED_DEFAULT",
  "fonts": {
    "family": "FandolHei",
    "fallback": [
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      "PingFang SC",
      "Arial Unicode MS"
    ],
    "title_pt": 12,
    "axis_pt": 10,
    "tick_pt": 9,
    "caption_pt": 9,
    "annotation_pt": 9,
    "final_pdf_minimum_pt_advisory": 8,
    "legend_pt": 9
  },
  "colors": {
    "categorical": [
      "#4665B9",
      "#A69CEB",
      "#FF9168",
      "#C68074",
      "#7196C7",
      "#B5A8D5"
    ],
    "sequential": [
      "#EEF3F4",
      "#C8DADD",
      "#9FBFC4",
      "#719AA3",
      "#4B747E"
    ],
    "neutral": "#666666",
    "background": "#FFFFFF",
    "text": "#262626",
    "grid": "#E8E8E8"
  },
  "effects": {
    "flat": true,
    "shadows": false,
    "glow": false,
    "heavy_borders": false,
    "decorative_3d": false,
    "spatial_3d": "when_data_requires_it",
    "continuous_color_scale": "when_encoding_numeric_values"
  },
  "accessibility": {
    "use_color_alone": false,
    "check_grayscale": true,
    "minimum_contrast_ratio": 3.0
  },
  "export": {
    "vector_preferred": true,
    "raster_dpi_advisory": 300,
    "check_after_insertion": true
  },
  "layout": {
    "legend": "compact_inside_when_clear_otherwise_outside",
    "grid": "light_major_lines",
    "spines": "thin_neutral",
    "panel_labels": "(a), (b), ...",
    "caption": "handled_by_paper_template",
    "time_panels": "align_x_axes"
  }
}
