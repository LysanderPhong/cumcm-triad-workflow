{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim evidence run record",
  "type": "object",
  "required": ["schema_version", "claim_id", "text", "evidence_refs", "run_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "claim_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "status": {"enum": ["DRAFT", "PROPOSED", "APPROVED", "REJECTED", "RELEASE_ELIGIBLE"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_role": {"enum": ["RUN_OUTPUT", "DECISION"]},
    "decision_ref": {"type": "string"},
    "review_ref": {"type": "string"}
  },
  "additionalProperties": true
}
